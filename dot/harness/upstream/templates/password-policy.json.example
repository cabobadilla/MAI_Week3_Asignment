    },
    "backend": {
      "below_minimum": "REPLACE_backend_below_minimum",
      "at_minimum": "REPLACE_backend_at_minimum",
      "above_minimum": "REPLACE_backend_above_minimum"
    },
    "provisioning": {
      "below_minimum": "REPLACE_provisioning_below_minimum",
      "at_minimum": "REPLACE_provisioning_at_minimum",
      "above_minimum": "REPLACE_provisioning_above_minimum"
    }
  }
}
