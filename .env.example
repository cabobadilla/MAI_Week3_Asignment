# App y almacenamiento locales; LLM remoto vía OpenRouter.
# El usuario completa .env por su cuenta. No incluir secretos reales aquí.
# Modelo de app elegido, configurable; sin fallback automático.
OPENROUTER_API_KEY=
APP_LLM_MODEL=qwen/qwen3.8-flash
APP_LLM_ENABLED=false
# Controles técnicos propuestos, no presupuesto monetario.
APP_LLM_MAX_INPUT_TOKENS=12000
APP_LLM_MAX_OUTPUT_TOKENS=4096
APP_LLM_MAX_TOTAL_TOKENS_PER_RUN=64000
APP_LLM_MAX_REQUEST_ATTEMPTS_PER_RUN=8
APP_LLM_MAX_RETRIES=2
APP_LLM_TIMEOUT_SECONDS=30
